<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0;net9.0</TargetFrameworks>
    <PackageId>TL.Kafka</PackageId>
    <Description>Adaptador resiliente de Apache Kafka implementando a abstração unificada IEventProducer e IEventHandler com suporte a Partition Keys, Dead Letter Topic (.dlt), idempotência e DI para .NET 6, .NET 8 e .NET 9.</Description>
    <PackageTags>kafka;confluent-kafka;messaging;event-driven;dlt;partition-key;idempotence;csharp;dotnet;net6;net8;net9;tl</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CommonHelpers.RequestResponse\CommonHelpers.RequestResponse.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Polly" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>

