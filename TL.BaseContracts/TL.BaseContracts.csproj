<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <PackageId>TL.BaseContracts</PackageId>
    <AssemblyName>TL.BaseContracts</AssemblyName>
    <RootNamespace>TL.BaseContracts</RootNamespace>
    <Version>0.2.0</Version>
    <Authors>Thaylon Lopes</Authors>
    <Company>TL Engenharia</Company>
    <Description>Fundação padronizada e unificada de contratos em BCL pura (Commands, Queries, Events, Results, Errors e Paginações) para aplicações .NET modernas e legadas.</Description>
    <PackageTags>contracts;result-pattern;cqrs;clean-architecture;ddd;error-handling;tl</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/thaylonlopes/BuildingBlocks</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>